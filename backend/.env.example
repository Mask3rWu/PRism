# 应用配置
PORT=8000
FRONTEND_URL=http://localhost:3000
FERNET_KEY=

# 默认 OpenAI 兼容 LLM（若通过页面配置，可不填）
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=
DEFAULT_LLM_BASE_URL=

# Langfuse 可观测性配置。两个 Key 都为空时不启用追踪。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=

# 默认不上传私有源码、Prompt 和模型输出；设为 true 才会上传完整内容。
LANGFUSE_TRACE_CONTENT=false

# 可选：自定义模型每百万 Token 的美元单价。保持为 0 时，已知模型由 Langfuse 自动计费。
LANGFUSE_INPUT_COST_PER_1M_TOKENS=0
LANGFUSE_CACHE_HIT_INPUT_COST_PER_1M_TOKENS=0
LANGFUSE_CACHE_MISS_INPUT_COST_PER_1M_TOKENS=0
LANGFUSE_OUTPUT_COST_PER_1M_TOKENS=0
